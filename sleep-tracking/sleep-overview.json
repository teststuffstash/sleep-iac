    {
      "title": "Bed → Wake times (per night, local)",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT night_date AS \"Night\", strftime('%H:%M', sleep_start, '+3 hours') AS \"Bed\", strftime('%H:%M', wake_time, '+3 hours') AS \"Wake\", printf('%d:%02d', total_sleep_min / 60, total_sleep_min % 60) AS \"Total\", printf('%d:%02d', COALESCE(nap_min, 0) / 60, COALESCE(nap_min, 0) % 60) AS \"Naps\", hr_avg AS \"Avg HR\", snore_score AS \"Snore score\" FROM sleep_nights ORDER BY night_date DESC",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "rawQueryText": "SELECT night_date AS \"Night\", strftime('%H:%M', sleep_start, '+3 hours') AS \"Bed\", strftime('%H:%M', wake_time, '+3 hours') AS \"Wake\", printf('%d:%02d', total_sleep_min / 60, total_sleep_min % 60) AS \"Total\", printf('%d:%02d', COALESCE(nap_min, 0) / 60, COALESCE(nap_min, 0) % 60) AS \"Naps\", hr_avg AS \"Avg HR\", snore_score AS \"Snore score\" FROM sleep_nights ORDER BY night_date DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
