{
  "title": "Sleep Overview",
  "uid": "sleep-overview",
  "description": "Nightly sleep tracking overview — stages, HR, snore",
  "tags": [
    "sleep-tracking",
    "health"
  ],
  "timezone": "Europe/Tallinn",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "panels": [
    {
      "title": "Sleep Stages (stacked)",
      "type": "barchart",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT night_date, ROUND(deep_min / 60.0, 2) AS deep, ROUND(light_min / 60.0, 2) AS light, ROUND(rem_min / 60.0, 2) AS rem, ROUND(awake_min / 60.0, 2) AS awake FROM sleep_nights ORDER BY night_date",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "rawQueryText": "SELECT night_date, ROUND(deep_min / 60.0, 2) AS deep, ROUND(light_min / 60.0, 2) AS light, ROUND(rem_min / 60.0, 2) AS rem, ROUND(awake_min / 60.0, 2) AS awake FROM sleep_nights ORDER BY night_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "h",
          "min": 0,
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "deep"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F60C4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "light"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3FA7F0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rem"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E0459B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "awake"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "auto",
        "groupWidth": 0.7,
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "title": "Total Sleep (h)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, (total_sleep_min - COALESCE(nap_min, 0)) * 60 AS \"Night sleep\", COALESCE(nap_min, 0) * 60 AS \"Naps\" FROM sleep_nights ORDER BY night_date",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, (total_sleep_min - COALESCE(nap_min, 0)) * 60 AS \"Night sleep\", COALESCE(nap_min, 0) * 60 AS \"Naps\" FROM sleep_nights ORDER BY night_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Night sleep"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Naps"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Overnight HR (avg / min)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, hr_avg, hr_min FROM sleep_nights ORDER BY night_date",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, hr_avg, hr_min FROM sleep_nights ORDER BY night_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bpm",
          "min": 40,
          "max": 120
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Snore Score & Snore %",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, snore_score, snore_pct FROM sleep_nights ORDER BY night_date",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT CAST(strftime('%s', night_date) AS INTEGER) AS time, snore_score, snore_pct FROM sleep_nights ORDER BY night_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Snore vs HR (correlation)",
      "type": "xychart",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sleep-notes"
      },
      "targets": [
        {
          "queryText": "SELECT snore_score AS \"Snore score\", hr_avg AS \"Overnight HR\", night_date FROM sleep_nights WHERE snore_score IS NOT NULL AND hr_avg IS NOT NULL ORDER BY snore_score",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sleep-notes"
          },
          "queryType": "table",
          "rawQueryText": "SELECT snore_score AS \"Snore score\", hr_avg AS \"Overnight HR\", night_date FROM sleep_nights WHERE snore_score IS NOT NULL AND hr_avg IS NOT NULL ORDER BY snore_score"
        }
      ],
      "options": {
        "mapping": "auto",
        "seriesMapping": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 9
            },
            "pointShape": "circle",
            "pointStrokeWidth": 1,
            "fillOpacity": 60,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Snore score"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Snore score"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Overnight HR"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bpm"
              },
              {
                "id": "custom.axisLabel",
                "value": "Overnight HR (bpm)"
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Snore vs Sleep Duration (correlation)",
