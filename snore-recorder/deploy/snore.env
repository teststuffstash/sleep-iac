# compose .env written to /opt/snore-recorder/.env on the Pi by deploy.yml. SNORE_IMAGE is the
# deploy PIN — the one knob (bumped by snore-recorder's build, mirroring the ingester). The S3 creds
# are NOT here: they live in /var/lib/snore-secrets/s3.env on the Pi (written once at flash time).
SNORE_IMAGE=ghcr.io/teststuffstash/snore-recorder:2026.8.30-ga8d5f2392b64
SNORE_TZ=Europe/Tallinn
SNORE_WINDOW_START=00:00
SNORE_WINDOW_END=09:00
SNORE_ARM_DELAY_MIN=20
SNORE_INPUT_DEVICE=Jabra
