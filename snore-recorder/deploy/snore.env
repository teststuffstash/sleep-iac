# compose .env written to /opt/snore-recorder/.env on the Pi by deploy.yml. SNORE_IMAGE is the
# deploy PIN — the one knob (bumped by snore-recorder's build, mirroring the ingester). The S3 creds
# are NOT here: they live in /var/lib/snore-secrets/s3.env on the Pi (written once at flash time).
SNORE_IMAGE=ghcr.io/teststuffstash/snore-recorder:2026.10.9-gce7f34cbf2d6
SNORE_TZ=Europe/Tallinn
SNORE_WINDOW_START=00:00
SNORE_WINDOW_END=09:00
SNORE_ARM_DELAY_MIN=20
# Mic = Behringer ECM8000-U (measurement mic, no DSP; replaced the Jabra's gated mic 2026-10-05).
# Its USB audio offers only 44.1/48/96 kHz stereo — the app downmixes to mono; the per-frame RMS
# classifier is rate-agnostic. The Jabra stays plugged in as the button/LED (HID) + speaker.
SNORE_INPUT_DEVICE=ECM8000
SNORE_SAMPLE_RATE=48000
SNORE_CHANNELS=2
